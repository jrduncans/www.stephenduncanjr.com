amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

// Top-level steps also form the check, fix and pre-commit hooks.
// Scope: the programmatic parts of the site (scripts, plugins, templates,
// styles, CI and tool config). Posts, pages and other content are not linted yet.

// Ruby scripts in bin/ have no extension, so name them alongside the .rb files.
local rubyFiles = List("**/*.rb", "Gemfile", "bin/check-current-posts", "bin/new-post", "bin/publish-post")

// Files where whitespace hygiene applies. Vendored legacy JS in scripts/ is left alone.
local codeFiles = List(
    "bin/**",
    "_plugins/**",
    "_layouts/**",
    "_includes/**",
    "_sass/**",
    "css/**",
    "js/**",
    ".github/**",
    "Gemfile",
    "_config.yml",
    "*.toml",
    "*.pkl"
)

local linters = new Mapping {
    // File hygiene, limited to code
    ["trailing_whitespace"] = (Builtins.trailing_whitespace) { glob = codeFiles }
    ["newlines"] = (Builtins.newlines) { glob = codeFiles }
    ["mixed_line_ending"] = (Builtins.mixed_line_ending) { glob = codeFiles }
    ["check_merge_conflict"] = Builtins.check_merge_conflict
    ["check_executables_have_shebangs"] = (Builtins.check_executables_have_shebangs) { glob = "bin/**" }
    ["check_shebang_scripts_are_executable"] = (Builtins.check_shebang_scripts_are_executable) { glob = "bin/**" }

    // Secrets
    ["gitleaks"] = (Builtins.gitleaks) { scan = "staged" }

    // Ruby: Standard (RuboCop with a fixed style), run through the bundle.
    ["standard_rb"] = (Builtins.standard_rb) {
        glob = rubyFiles
        check = new CommandSpec { command = "bundle exec standardrb {{files}}"; effect = "read" }
        fix = new CommandSpec { command = "bundle exec standardrb --fix {{files}}"; effect = "write" }
    }

    // Shell
    ["shellcheck"] = Builtins.shellcheck
    ["shfmt"] = Builtins.shfmt

    // GitHub Actions
    ["jactionlint"] = Builtins.jactionlint
    ["zizmor"] = Builtins.zizmor
    ["pinact"] = Builtins.pinact

    // Tool config
    ["pkl"] = Builtins.pkl
}

steps = linters

hooks {
    ["pre-push"] {
        steps {
            // The full production build plus URL-compatibility checks.
            // The glob matches every file, so it is skipped when no files are pushed (remote branch deletion).
            ["check_site"] = new Step {
                glob = "**/*"
                check = new CommandSpec { command = "bundle exec bin/check-site"; effect = "read" }
            }
        }
    }
}
