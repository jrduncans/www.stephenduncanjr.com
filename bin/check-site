#!/usr/bin/env bash

set -euo pipefail

root_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
fixture="$root_dir/test/fixtures/legacy-urls.txt"
destination="$(mktemp -d "${TMPDIR:-/tmp}/stephenduncan-site-check.XXXXXX")"

cleanup() {
  rm -rf -- "$destination"
}
trap cleanup EXIT

if [[ ! -f "$fixture" ]]; then
  printf 'Missing compatibility fixture: %s\n' "$fixture" >&2
  exit 1
fi

cd "$root_dir"

printf 'Building a fresh site in %s\n' "$destination"
printf 'Build timezone: America/Los_Angeles\n'
TZ=America/Los_Angeles JEKYLL_ENV="${JEKYLL_ENV:-production}" bundle exec jekyll build --destination "$destination"

if ! LC_ALL=C sort -c "$fixture" >/dev/null; then
  printf 'Compatibility fixture is not sorted: %s\n' "$fixture" >&2
  exit 1
fi

duplicates="$(LC_ALL=C sort "$fixture" | uniq -d)"
if [[ -n "$duplicates" ]]; then
  printf 'Compatibility fixture contains duplicate paths:\n%s\n' "$duplicates" >&2
  exit 1
fi

required_count=0
missing_count=0
missing_paths=()

while IFS= read -r url_path || [[ -n "$url_path" ]]; do
  [[ -z "$url_path" ]] && continue

  if [[ "$url_path" != /* ]]; then
    printf 'Compatibility fixture contains a non-URL path: %s\n' "$url_path" >&2
    exit 1
  fi

  if [[ "$url_path" == "/" ]]; then
    output_path="$destination/index.html"
  elif [[ "$url_path" == */ ]]; then
    output_path="$destination/${url_path#/}index.html"
  else
    output_path="$destination/${url_path#/}"
  fi

  required_count=$((required_count + 1))
  if [[ ! -f "$output_path" ]]; then
    missing_count=$((missing_count + 1))
    missing_paths+=("$url_path")
  fi
done < "$fixture"

if (( missing_count > 0 )); then
  printf 'Missing %d of %d required legacy paths:\n' "$missing_count" "$required_count" >&2
  printf '  %s\n' "${missing_paths[@]}" >&2
  exit 1
fi

printf 'Verified %d required legacy paths in a fresh build.\n' "$required_count"

assert_file() {
  local path="$1"

  if [[ ! -f "$path" ]]; then
    printf 'Expected output is missing: %s\n' "$path" >&2
    exit 1
  fi
}

assert_contains() {
  local path="$1"
  local expected="$2"

  if ! rg -Fq -- "$expected" "$path"; then
    printf 'Expected %s to contain: %s\n' "$path" "$expected" >&2
    exit 1
  fi
}

assert_not_contains() {
  local path="$1"
  local unexpected="$2"

  if rg -Fq -- "$unexpected" "$path"; then
    printf 'Expected %s not to contain: %s\n' "$path" "$unexpected" >&2
    exit 1
  fi
}

legacy_post="$destination/2002/03/testing.html"
archive_page="$destination/archive/index.html"
feed_page="$destination/feed.xml"

assert_file "$archive_page"
assert_file "$destination/404.html"
assert_file "$destination/feeds/posts/default/index.html"
assert_file "$feed_page"
assert_contains "$archive_page" 'Previous site, 2002–2018'
assert_contains "$archive_page" '<meta name="robots" content="noindex,follow">'
assert_contains "$archive_page" '/2002/03/testing.html'
assert_contains "$archive_page" '/writing/writing.html'
assert_contains "$archive_page" '/pictures.html'
assert_contains "$archive_page" '/projects.html'
assert_contains "$archive_page" '/firefoxthemes.html'
assert_contains "$archive_page" 'CooperDuncanGregg4.pdf'
assert_contains "$legacy_post" '<meta name="robots" content="noindex,follow">'
assert_contains "$legacy_post" '<link rel="canonical" href="https://www.stephenduncanjr.com/2002/03/testing.html">'
assert_contains "$destination/about.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/google719de6b83ee3367a.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/2005/04/index.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/tag/programming/index.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/404.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/feeds/posts/default/index.html" '<meta name="robots" content="noindex,follow">'
assert_not_contains "$destination/index.html" 'Testing'
assert_not_contains "$feed_page" 'testing.html'
assert_not_contains "$archive_page" 'era: current'

fixture_source="$(mktemp -d "${TMPDIR:-/tmp}/stephenduncan-current-fixture-source.XXXXXX")"
fixture_destination="$(mktemp -d "${TMPDIR:-/tmp}/stephenduncan-current-fixture-build.XXXXXX")"
fixture_word="fixture"
fixture_slug="phase-2-current-${fixture_word}"

cleanup_fixture() {
  rm -rf -- "$destination" "$fixture_source" "$fixture_destination"
}
trap cleanup_fixture EXIT

cp -R -- "$root_dir"/. "$fixture_source"/
cat > "$fixture_source/_posts/2026-08-20-${fixture_slug}.md" <<EOF
---
layout: post
title: Phase 2 Current Fixture
date: 2026-08-20 12:00:00 -0700
era: current
permalink: /posts/${fixture_slug}/
---

This post exists only for the phase verification build.
EOF

printf 'Building isolated current-era fixture in %s\n' "$fixture_destination"
TZ=America/Los_Angeles JEKYLL_ENV=production bundle exec jekyll build \
  --source "$fixture_source" \
  --destination "$fixture_destination"

assert_contains "$fixture_destination/index.html" 'Phase 2 Current Fixture'
assert_contains "$fixture_destination/feed.xml" 'Phase 2 Current Fixture'
assert_contains "$fixture_destination/feed.xml" "/posts/${fixture_slug}/"
assert_not_contains "$fixture_destination/posts/${fixture_slug}/index.html" '<meta name="robots" content="noindex,follow">'
assert_not_contains "$fixture_destination/archive/index.html" 'Phase 2 Current Fixture'
assert_not_contains "$destination/index.html" 'Phase 2 Current Fixture'
assert_not_contains "$destination/feed.xml" 'Phase 2 Current Fixture'
if ! ruby -rrexml/document -e 'REXML::Document.new(File.read(ARGV.fetch(0)))' "$feed_page"; then
  printf 'Generated feed is not valid XML: %s\n' "$feed_page" >&2
  exit 1
fi
if rg -Fq -- "$fixture_slug" "$root_dir/_posts"; then
  printf 'Temporary current-era fixture leaked into production source.\n' >&2
  exit 1
fi

printf 'Verified current-era homepage/feed inclusion and legacy separation.\n'
