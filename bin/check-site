#!/usr/bin/env bash

set -euo pipefail

root_dir="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
fixture="$root_dir/test/fixtures/legacy-urls.txt"
destination="$(mktemp -d "${TMPDIR:-/tmp}/stephenduncan-site-check.XXXXXX")"

cleanup() {
  rm -rf -- "$destination"
}
trap cleanup EXIT

if [[ ! -f "$fixture" ]]; then
  printf 'Missing compatibility fixture: %s\n' "$fixture" >&2
  exit 1
fi

cd "$root_dir"

bin/check-current-posts

printf 'Building a fresh site in %s\n' "$destination"
printf 'Build timezone: America/Los_Angeles\n'
TZ=America/Los_Angeles JEKYLL_ENV="${JEKYLL_ENV:-production}" bundle exec jekyll build --destination "$destination"

if ! LC_ALL=C sort -c "$fixture" >/dev/null; then
  printf 'Compatibility fixture is not sorted: %s\n' "$fixture" >&2
  exit 1
fi

duplicates="$(LC_ALL=C sort "$fixture" | uniq -d)"
if [[ -n "$duplicates" ]]; then
  printf 'Compatibility fixture contains duplicate paths:\n%s\n' "$duplicates" >&2
  exit 1
fi

required_count=0
missing_count=0
missing_paths=()

while IFS= read -r url_path || [[ -n "$url_path" ]]; do
  [[ -z "$url_path" ]] && continue

  if [[ "$url_path" != /* ]]; then
    printf 'Compatibility fixture contains a non-URL path: %s\n' "$url_path" >&2
    exit 1
  fi

  if [[ "$url_path" == "/" ]]; then
    output_path="$destination/index.html"
  elif [[ "$url_path" == */ ]]; then
    output_path="$destination/${url_path#/}index.html"
  else
    output_path="$destination/${url_path#/}"
  fi

  required_count=$((required_count + 1))
  if [[ ! -f "$output_path" ]]; then
    missing_count=$((missing_count + 1))
    missing_paths+=("$url_path")
  fi
done <"$fixture"

if ((missing_count > 0)); then
  printf 'Missing %d of %d required legacy paths:\n' "$missing_count" "$required_count" >&2
  printf '  %s\n' "${missing_paths[@]}" >&2
  exit 1
fi

printf 'Verified %d required legacy paths in a fresh build.\n' "$required_count"

assert_file() {
  local path="$1"

  if [[ ! -f "$path" ]]; then
    printf 'Expected output is missing: %s\n' "$path" >&2
    exit 1
  fi
}

assert_contains() {
  local path="$1"
  local expected="$2"

  if ! grep -Fq -- "$expected" "$path"; then
    printf 'Expected %s to contain: %s\n' "$path" "$expected" >&2
    exit 1
  fi
}

assert_not_contains() {
  local path="$1"
  local unexpected="$2"

  if grep -Fq -- "$unexpected" "$path"; then
    printf 'Expected %s not to contain: %s\n' "$path" "$unexpected" >&2
    exit 1
  fi
}

legacy_post="$destination/2002/03/testing.html"
archive_page="$destination/archive/index.html"
current_posts_page="$destination/posts/index.html"
feed_page="$destination/feed.xml"
home_page="$destination/index.html"
stylesheet="$destination/css/default.css"

assert_file "$archive_page"
assert_file "$current_posts_page"
assert_file "$destination/404.html"
assert_file "$destination/feeds/posts/default/index.html"
assert_file "$feed_page"
assert_file "$stylesheet"
assert_contains "$home_page" '<meta name="viewport" content="width=device-width, initial-scale=1">'
assert_contains "$home_page" '<a class="skip-link" href="#main-content">Skip to content</a>'
assert_contains "$home_page" '<main id="main-content" class="site-main">'
assert_contains "$home_page" '<h1 class="visually-hidden">Recent posts</h1>'
assert_not_contains "$home_page" '<nav class="site-nav"'
assert_contains "$home_page" '<footer class="site-footer">'
assert_contains "$home_page" '<nav class="site-footer__inner" aria-label="Footer">'
assert_contains "$home_page" '>All posts</a>'
assert_contains "$home_page" '>RSS</a>'
assert_contains "$home_page" '>Bluesky</a>'
assert_contains "$home_page" '>GitHub</a>'
assert_contains "$home_page" '>Mastodon</a>'
assert_not_contains "$home_page" 'href="/archive/"'
assert_not_contains "$home_page" '>Journal</h1>'
assert_not_contains "$home_page" 'Latest writing'
assert_contains "$home_page" '<link rel="canonical" href="https://www.stephenduncanjr.com/">'
assert_contains "$stylesheet" '--color-bg:'
assert_contains "$stylesheet" 'prefers-color-scheme: dark'
assert_contains "$stylesheet" 'prefers-reduced-motion: reduce'
assert_not_contains "$home_page" '<script'
assert_not_contains "$home_page" 'google.com/jsapi'
assert_not_contains "$home_page" 'disqus'
assert_contains "$archive_page" 'Archive (2002–2018)'
assert_contains "$archive_page" 'at their original URLs'
assert_contains "$archive_page" '<meta name="robots" content="noindex,follow">'
assert_contains "$archive_page" '/2002/03/testing.html'
assert_contains "$archive_page" '/writing/writing.html'
assert_contains "$archive_page" '/pictures.html'
assert_contains "$archive_page" '/projects.html'
assert_contains "$archive_page" '/firefoxthemes.html'
assert_contains "$archive_page" 'CooperDuncanGregg4.pdf'
assert_contains "$current_posts_page" '<h1>All posts</h1>'
assert_contains "$current_posts_page" 'href="/archive/"'
assert_contains "$current_posts_page" '>Archive <span aria-hidden="true">→</span></a>'
assert_not_contains "$current_posts_page" '<meta name="robots" content="noindex,follow">'
assert_contains "$legacy_post" '<meta name="robots" content="noindex,follow">'
assert_contains "$legacy_post" '<link rel="canonical" href="https://www.stephenduncanjr.com/2002/03/testing.html">'
assert_contains "$destination/about.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/google719de6b83ee3367a.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/2005/04/index.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/tag/programming/index.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/404.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$destination/feeds/posts/default/index.html" '<meta name="robots" content="noindex,follow">'
assert_contains "$legacy_post" '<article class="post post--full">'
assert_not_contains "$legacy_post" 'disqus_thread'
assert_not_contains "$destination/index.html" 'Testing'
assert_not_contains "$feed_page" 'testing.html'
assert_not_contains "$archive_page" 'era: current'

fixture_source="$(mktemp -d "${TMPDIR:-/tmp}/stephenduncan-current-fixture-source.XXXXXX")"
fixture_destination="$(mktemp -d "${TMPDIR:-/tmp}/stephenduncan-current-fixture-build.XXXXXX")"
fixture_word="fixture"
fixture_slug="phase-2-current-${fixture_word}"

cleanup_fixture() {
  rm -rf -- "$destination" "$fixture_source" "$fixture_destination"
}
trap cleanup_fixture EXIT

cp -R -- "$root_dir"/. "$fixture_source"/
cat >"$fixture_source/_posts/2026-08-20-${fixture_slug}.md" <<EOF
---
layout: post
title: Phase 2 Current Fixture
date: 2026-08-20 12:00:00 -0700
description: Temporary current-era fixture used by the compatibility check.
era: current
permalink: /posts/${fixture_slug}/
---

This post exists only for the phase verification build.

~~~ruby
puts "Rouge fixture"
~~~
EOF

for fixture_day in {10..19}; do
  overflow_slug="homepage-overflow-${fixture_day}"
  cat >"$fixture_source/_posts/2026-08-${fixture_day}-${overflow_slug}.md" <<EOF
---
layout: post
title: Homepage Overflow Fixture ${fixture_day}
date: 2026-08-${fixture_day} 12:00:00 -0700
description: Temporary fixture used to verify the current post index.
era: current
permalink: /posts/${overflow_slug}/
---

This post exists only for the phase verification build.
EOF
done

printf 'Building isolated current-era fixture in %s\n' "$fixture_destination"
TZ=America/Los_Angeles JEKYLL_ENV=production bundle exec jekyll build \
  --source "$fixture_source" \
  --destination "$fixture_destination"

assert_contains "$fixture_destination/index.html" 'Phase 2 Current Fixture'
assert_contains "$fixture_destination/index.html" '>All posts <span aria-hidden="true">→</span></a>'
assert_not_contains "$fixture_destination/index.html" 'Homepage Overflow Fixture 10'
assert_contains "$fixture_destination/posts/index.html" 'Homepage Overflow Fixture 10'
assert_contains "$fixture_destination/posts/index.html" 'Phase 2 Current Fixture'
assert_contains "$fixture_destination/posts/index.html" 'href="/archive/"'
assert_contains "$fixture_destination/feed.xml" 'Phase 2 Current Fixture'
assert_contains "$fixture_destination/feed.xml" "/posts/${fixture_slug}/"
assert_contains "$fixture_destination/posts/${fixture_slug}/index.html" 'language-ruby'
assert_not_contains "$fixture_destination/posts/${fixture_slug}/index.html" '<meta name="robots" content="noindex,follow">'
assert_not_contains "$fixture_destination/archive/index.html" 'Phase 2 Current Fixture'
assert_not_contains "$destination/index.html" 'Phase 2 Current Fixture'
assert_not_contains "$destination/feed.xml" 'Phase 2 Current Fixture'
if ! ruby -rrexml/document -e 'REXML::Document.new(File.read(ARGV.fetch(0)))' "$feed_page"; then
  printf 'Generated feed is not valid XML: %s\n' "$feed_page" >&2
  exit 1
fi
if grep -RFq -- "$fixture_slug" "$root_dir/_posts"; then
  printf 'Temporary current-era fixture leaked into production source.\n' >&2
  exit 1
fi

printf 'Verified capped current-era homepage, complete post index/feed, and legacy separation.\n'

validation_fixture_source="$(mktemp -d "${TMPDIR:-/tmp}/stephenduncan-current-validation.XXXXXX")"
cleanup_validation_fixture() {
  rm -rf -- "$destination" "$fixture_source" "$fixture_destination" "$validation_fixture_source"
}
trap cleanup_validation_fixture EXIT
cp -R -- "$root_dir"/. "$validation_fixture_source"/

check_invalid_current_post() {
  local expected="$1"

  if "$validation_fixture_source/bin/check-current-posts" >"$validation_fixture_source/check.out" 2>&1; then
    printf 'Expected current-post validation to fail for: %s\n' "$expected" >&2
    exit 1
  fi
  if ! grep -Fq -- "$expected" "$validation_fixture_source/check.out"; then
    printf 'Expected current-post validation error: %s\n' "$expected" >&2
    cat "$validation_fixture_source/check.out" >&2
    exit 1
  fi
}

cat >"$validation_fixture_source/_posts/2026-08-20-missing-description.md" <<'EOF'
---
layout: post
title: Missing description fixture
date: 2026-08-20 12:00:00 -0700
era: current
permalink: /posts/missing-description-fixture/
---
EOF
check_invalid_current_post 'missing a short description'
rm "$validation_fixture_source/_posts/2026-08-20-missing-description.md"

cat >"$validation_fixture_source/_posts/2026-08-20-missing-era.md" <<'EOF'
---
layout: post
title: Missing era fixture
date: 2026-08-20 12:00:00 -0700
description: A fixture with the new URL shape but no current-era marker.
permalink: /posts/missing-era-fixture/
---
EOF
check_invalid_current_post 'missing era: current'
rm "$validation_fixture_source/_posts/2026-08-20-missing-era.md"

cat >"$validation_fixture_source/_posts/2026-08-20-unmarked-dated-post.md" <<'EOF'
---
layout: post
title: Unmarked dated post fixture
date: 2026-08-20 12:00:00 -0700
description: A new dated post must not silently become a legacy post.
---
EOF
check_invalid_current_post 'is not a preserved legacy post and must set era: current'
rm "$validation_fixture_source/_posts/2026-08-20-unmarked-dated-post.md"

cat >"$validation_fixture_source/_posts/2026-08-20-duplicate-one.md" <<'EOF'
---
layout: post
title: Duplicate one fixture
date: 2026-08-20 12:00:00 -0700
description: The first duplicate permalink fixture.
era: current
permalink: /posts/duplicate-fixture/
---
EOF
cat >"$validation_fixture_source/_posts/2026-08-21-duplicate-two.md" <<'EOF'
---
layout: post
title: Duplicate two fixture
date: 2026-08-21 12:00:00 -0700
description: The second duplicate permalink fixture.
era: current
permalink: /posts/duplicate-fixture/
---
EOF
check_invalid_current_post 'duplicate current permalink /posts/duplicate-fixture/'
rm "$validation_fixture_source/_posts/2026-08-20-duplicate-one.md" "$validation_fixture_source/_posts/2026-08-21-duplicate-two.md"

cat >"$validation_fixture_source/_posts/2026-08-20-legacy-url.md" <<'EOF'
---
layout: post
title: Legacy URL fixture
date: 2026-08-20 12:00:00 -0700
description: A fixture that must not reuse dated legacy URLs.
era: current
permalink: /2026/08/legacy-url.html
---
EOF
check_invalid_current_post 'permalink must be /posts/<stable-slug>/'
rm "$validation_fixture_source/_posts/2026-08-20-legacy-url.md"

mkdir -p "$validation_fixture_source/posts/output-collision"
cat >"$validation_fixture_source/posts/output-collision/index.md" <<'EOF'
---
layout: default
title: Output collision fixture
---
EOF
cat >"$validation_fixture_source/_posts/2026-08-20-output-collision.md" <<'EOF'
---
layout: post
title: Output collision fixture
date: 2026-08-20 12:00:00 -0700
description: A fixture that collides with a page output path.
era: current
permalink: /posts/output-collision/
---
EOF
check_invalid_current_post 'output /posts/output-collision/index.html collides with'

printf 'Verified current-post validation failures and Rouge fenced-code output.\n'
